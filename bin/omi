#!/usr/bin/env node
// OMI CLI launcher. Resolves runtime relative to this file: no machine-specific paths.
// Node 22 flags node:sqlite as experimental on every run; that notice is not OMI output (stderr
// stays for real errors). Filtered before the runtime loads, hence the dynamic import.
const emitWarning = process.emitWarning;
process.emitWarning = (warning, ...rest) => {
  if (rest[0] === "ExperimentalWarning" && String(warning).includes("SQLite")) return;
  emitWarning.call(process, warning, ...rest);
};
const { main } = await import("../runtime/cli/main.ts");

const r = main(process.argv.slice(2));
process.stdout.write(r.stdout);
process.stderr.write(r.stderr);
process.exitCode = r.code;
