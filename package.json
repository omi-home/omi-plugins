{
  "name": "omi-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "OMI Engineering Plugin: Claude Code plugin + deterministic local runtime",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
