{
  "name": "omi-plugins",
  "version": "0.2.0",
  "private": true,
  "description": "OMI Engineering Plugin: Claude Code plugin + deterministic local runtime",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "schemas:monitor": "node runtime/monitor/adapters/schemas.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "arch": "node bin/omi arch check",
    "check": "npm run lint && npm run typecheck && npm run arch && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
