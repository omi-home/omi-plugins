{
  "title": "ConfigSetInput",
  "protocolVersion": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "changes": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z0-9-]+)*$"
              },
              "value": {}
            },
            "required": [
              "path",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z0-9-]+)*$"
              },
              "unset": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "path",
              "unset"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "changes"
  ],
  "additionalProperties": false
}
