              "default": 2,
              "type": "number",
              "const": 2
            },
            "maxAttempts": {
              "default": 3,
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxValidationFixes": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "maxQaReworks": {
              "default": 2,
              "type": "integer",
