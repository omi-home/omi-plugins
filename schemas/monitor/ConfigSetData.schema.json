          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "pattern": "^[\\w.-]+$"
            },
            "repo": {
              "type": "string",
              "pattern": "^[\\w.-]+$"
            },
            "projectNumber": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "privateRepoRiskAccepted": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "owner",
            "repo",
            "projectNumber",
            "privateRepoRiskAccepted"
          ],
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "properties": {
            "baseBranch": {
              "default": "develop",
              "type": "string",
              "minLength": 1
            },
            "releaseBranch": {
              "default": "main",
              "type": "string",
              "minLength": 1
            },
            "mergeMethod": {
              "default": "squash",
              "type": "string",
              "enum": [
                "squash",
                "merge",
                "rebase"
              ]
            }
          },
          "required": [
            "baseBranch",
            "releaseBranch",
            "mergeMethod"
          ],
          "additionalProperties": false
        },
