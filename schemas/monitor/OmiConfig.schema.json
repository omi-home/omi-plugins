{
  "title": "OmiConfig",
  "protocolVersion": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "secrets": {
      "default": {},
      "type": "object",
      "properties": {
        "keyEnv": {
          "default": "OMI_SECRET_KEY",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[\\w.-]+$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+$"
        },
        "projectNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "privateRepoRiskAccepted": {
          "default": false,
          "type": "boolean"
        },
        "model": {
          "default": "legacy",
          "type": "string",
          "enum": [
            "legacy",
            "v2"
          ]
        },
        "workflow": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "owner",
        "repo",
        "projectNumber"
      ],
      "additionalProperties": false
    },
    "git": {
      "default": {},
      "type": "object",
      "properties": {
        "baseBranch": {
          "default": "develop",
          "type": "string",
          "minLength": 1
        },
        "releaseBranch": {
          "default": "main",
          "type": "string",
          "minLength": 1
        },
        "mergeMethod": {
          "default": "squash",
          "type": "string",
          "enum": [
            "squash",
            "merge",
            "rebase"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "default": {},
      "type": "object",
      "properties": {
        "maxRounds": {
          "default": 4,
          "type": "number",
          "const": 4
        },
        "architectAfterFailedRounds": {
          "default": 2,
          "type": "number",
          "const": 2
        },
        "maxAttempts": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "maxValidationFixes": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "maxQaReworks": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "default": {},
      "type": "object",
      "properties": {
        "maxConcurrent": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "routing": {
          "default": {},
          "type": "object",
          "properties": {
            "business-analyst": {
              "default": {
                "model": "sonnet",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "solution-architect": {
              "default": {
                "model": "opus",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "ui-ux-designer": {
              "default": {
                "model": "sonnet",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "software-engineer": {
              "default": {
                "model": "sonnet",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "code-reviewer": {
              "default": {
                "model": "opus",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "security-reviewer": {
              "default": {
                "model": "opus",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            },
            "qa-engineer": {
              "default": {
                "model": "sonnet",
                "effort": "medium"
              },
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": [
                    "sonnet",
                    "opus",
                    "haiku"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                }
              },
              "required": [
                "model",
                "effort"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "contractRepairs": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "sessionMaxTokens": {
          "default": 3000000,
          "type": "integer",
          "minimum": 10000,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "qa": {
      "default": {},
      "type": "object",
      "properties": {
        "designLabel": {
          "default": "qa:test-design",
          "type": "string",
          "pattern": "^[\\w:. -]{1,50}$"
        }
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "timeoutSec": {
          "default": 600,
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "run"
      ],
      "additionalProperties": false
    },
    "checks": {
      "default": {},
      "type": "object",
      "properties": {
        "format": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        "lint": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        "architecture": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        "build": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        "test": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        },
        "scan": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "timeoutSec": {
              "default": 600,
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "contract": {
          "default": "omi-architecture.yaml",
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[\\w./-]+$"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "default": {},
      "type": "object",
      "properties": {
        "keep": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "default": {},
      "type": "object",
      "properties": {
        "deleteRemoteBranch": {
          "default": false,
          "type": "boolean"
        },
        "logRetentionDays": {
          "default": 14,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "github"
  ],
  "additionalProperties": false
}
